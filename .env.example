# ContractBench — LLM Provider API Keys
# Copy this file to .env and fill in the keys for providers you want to use.
#
#   cp .env.example .env
#
# Only the provider(s) you plan to evaluate need keys set.
# The runner will error clearly if a required key is missing.

# ── OpenAI ──────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Anthropic ───────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Google (Gemini) ─────────────────────────────────────────
GOOGLE_API_KEY=

# ── Together AI (Llama, Qwen, etc.) ────────────────────────
TOGETHER_API_KEY=

# ── Hugging Face Inference API (free tier) ────────────────
# Get token at: https://huggingface.co/settings/tokens
HF_TOKEN=

# ── Optional: Override base URLs (for proxies / Azure) ──────
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# TOGETHER_BASE_URL=https://api.together.xyz/v1
# HF_BASE_URL=https://router.huggingface.co/v1
